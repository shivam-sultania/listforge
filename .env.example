# Supabase → Project Settings → Database → Connect
#
# Runtime queries. Shared transaction pooler, port 6543.
DATABASE_URL="postgres://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma CLI only (migrate, db push). Session pooler, port 5432.
# Do NOT use the "direct connection" string (db.PROJECT_REF.supabase.co) — it is
# IPv6-only without a paid add-on and will time out from Vercel.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Seed only: the first dev account (prisma db seed). Not needed at runtime.
SEED_DEV_EMAIL="dev@listforge.dev"
SEED_DEV_PASSWORD="choose-a-strong-password"
